{
  "build": {
    "beforeDevCommand": "cd ../ui && trunk watch",
    "beforeBuildCommand": "cd ../ui && trunk build --release",
    "frontendDist": "../ui/dist"
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": ["app", "deb", "dmg", "msi"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "icons/tray/trayicon.png"
    ]
  },
  "productName": "QuiltSync",
  "mainBinaryName": "QuiltSync",
  "identifier": "com.quiltdata.quilt-sync",
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["quilt+s3", "quilt"]
      }
    },
    "updater": {
      "active": true,
      "endpoints": [
        "https://www.quilt.bio/hubfs/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFGNTdCMUVDQUJBN0U1MkUKUldRdTVhZXI3TEZYcjdYSzdPM0VidFB1bzErUnVLdmk4amV4NXZhU0lOc290Q3dZTncrZTFFQTYK"
    }
  },
  "app": {
    "security": {
      "capabilities": []
    }
  }
}
