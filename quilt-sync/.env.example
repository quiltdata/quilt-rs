# Telemetry credentials.
#
# A release build gets these baked in at build time by the release workflow. A
# local build reads this file (dotenv is loaded only under debug_assertions) and
# stays SILENT regardless — unless you also set QUILTSYNC_TELEMETRY_DEV below.
#
# Point these at a THROWAWAY Mixpanel project and Sentry project. A local build
# that opts in reports as environment=development and marks its analytics
# requests as test traffic, but the credentials are what actually keep your
# clicks out of the real dataset.
SENTRY_DSN=https://your-dsn-here@sentry.io/project-id
MIXPANEL_PROJECT_TOKEN=your-mixpanel-project-token-here
MIXPANEL_API_SECRET=your-mixpanel-api-secret-here

# Opt a local build in to live telemetry. Unset (or 0) means no telemetry, which
# is the default a developer who does nothing gets. Any other value opts in.
#
# Has no build-time form on purpose, so a released binary cannot carry it. With
# it set, every event is echoed to the terminal as it is sent.
#
#   just start-telemetry
#
# Caveat: option_env! reads the *compiler's* environment, so if the production
# token is exported in the shell you build from, it is baked into your local
# binary. Keep real credentials out of your shell profile.
QUILTSYNC_TELEMETRY_DEV=1
